PORT=3000
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=none
GEMINI_API_KEY=sua_chave_do_gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sua_chave_da_openai
OPENAI_MODEL=gpt-5-mini
AI_CACHE_TTL_MINUTES=1440
AI_CACHE_MAX_ENTRIES=100
AI_DOCUMENT_CACHE_TTL_DAYS=30
MAX_PDF_SIZE_MB=20
CORS_ORIGIN=*

# Backend only. Never copy an Admin service-account key into the Android project.
FIREBASE_PROJECT_ID=agendaacademicabd
FIRESTORE_DATABASE_ID=(default)
# Prefer GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json locally.
# On Render set FIREBASE_SERVICE_ACCOUNT_JSON as a secret containing the complete JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=
TESTER_UIDS=
ADMIN_UIDS=
# For npm run resolve:accounts (local only); configure the approved account emails.
RELEASE_ADMIN_EMAILS=
RELEASE_TESTER_EMAILS=

# Actual USD per million token prices for EVERY active model, including fallbacks.
# Empty prices are allowed locally (cost is unknown), but block production startup.
# Shape: {"provider:model":{"version":"tariff-date","inputUsdPerMillion":NUMBER,"cachedInputUsdPerMillion":NUMBER,"outputUsdPerMillion":NUMBER}}
AI_PRICES_JSON={}
USER_DAILY_REQUESTS=20
GLOBAL_DAILY_REQUESTS=200
USER_REQUESTS_PER_MINUTE=3
USER_DAILY_AI_ATTEMPTS=40
GLOBAL_DAILY_AI_ATTEMPTS=400
USER_DAILY_USD=1
GLOBAL_DAILY_USD=10
MAX_UPLOAD_TOTAL_MB=20
MAX_CONCURRENT_EXTRACTIONS=2
