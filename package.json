{
  "name": "agenda-academica-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "resolve:accounts": "tsx scripts/resolve-accounts.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "openai": "^7.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
